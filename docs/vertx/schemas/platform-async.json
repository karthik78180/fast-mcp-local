{
  "type": "platform-async",
  "name": "Platform AsyncHandler",
  "description": "Asynchronous, non-blocking handler for HTTP clients, async databases, and message queues",
  "template_file": "templates/platform-async-handler.md",
  "handler_interface": "AsyncHandler",
  "thread_model": "event_loop",
  "blocking_allowed": false,
  "gradle_dependencies": [
    "io.vertx:vertx-core:4.5.0",
    "io.vertx:vertx-web:4.5.0",
    "io.vertx:vertx-pg-client:4.5.0",
    "io.vertx:vertx-web-client:4.5.0"
  ],
  "interface_methods": [
    "void start(Vertx vertx, JsonObject config)",
    "void handle(RoutingContext context)",
    "void stop()",
    "JsonObject getData()"
  ],
  "config_structure": {
    "lambda_json": {
      "artifactId": "string",
      "verticleClass": "string",
      "version": "string",
      "endpoint": "string",
      "handlerType": "AsyncHandler"
    },
    "config_json": {
      "database": {
        "host": "string",
        "port": "number",
        "database": "string",
        "user": "string",
        "password": "string",
        "maxPoolSize": "number"
      },
      "externalApi": {
        "host": "string",
        "port": "number",
        "ssl": "boolean",
        "path": "string",
        "apiKey": "string",
        "connectTimeout": "number",
        "requestTimeout": "number"
      }
    }
  },
  "use_cases": [
    "PostgreSQL async queries with connection pooling",
    "HTTP REST API calls to external services",
    "MongoDB async operations",
    "Redis cache operations",
    "Kafka message publishing",
    "RabbitMQ async messaging",
    "Any non-blocking I/O operations"
  ],
  "examples": [
    {
      "name": "PostgreSQL Query Verticle",
      "description": "Async database queries with connection pooling",
      "operations": ["Database queries", "Connection pooling", "Prepared statements"]
    },
    {
      "name": "External API Verticle",
      "description": "Call external REST APIs asynchronously",
      "operations": ["HTTP GET/POST", "API authentication", "Response processing"]
    }
  ],
  "best_practices": [
    "Never block the event loop",
    "Always handle errors with .onFailure()",
    "Use connection pooling for databases",
    "Initialize resources in start()",
    "Clean up resources in stop()",
    "Use config().getData() for configuration",
    "Return proper HTTP status codes"
  ],
  "platform_managed": [
    "Deployment and routing",
    "Configuration loading",
    "Endpoint registration",
    "Event loop thread management"
  ]
}
