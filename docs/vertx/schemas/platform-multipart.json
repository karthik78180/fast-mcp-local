{
  "type": "platform-multipart",
  "name": "Platform MultipartHandler",
  "description": "File upload and multipart form data handler for image uploads, document storage, and file processing",
  "template_file": "templates/platform-multipart-handler.md",
  "handler_interface": "MultipartHandler",
  "thread_model": "worker_pool",
  "blocking_allowed": true,
  "gradle_dependencies": [
    "io.vertx:vertx-core:4.5.0",
    "io.vertx:vertx-web:4.5.0",
    "software.amazon.awssdk:bom:2.20.0",
    "software.amazon.awssdk:s3",
    "software.amazon.awssdk:auth",
    "org.imgscalr:imgscalr-lib:4.2"
  ],
  "interface_methods": [
    "void start(Vertx vertx, JsonObject config)",
    "void handle(RoutingContext context)",
    "void stop()",
    "JsonObject getData()"
  ],
  "config_structure": {
    "lambda_json": {
      "artifactId": "string",
      "verticleClass": "string",
      "version": "string",
      "endpoint": "string",
      "handlerType": "MultipartHandler"
    },
    "config_json": {
      "upload": {
        "directory": "string",
        "maxFileSizeBytes": "number",
        "allowedMimeTypes": "array",
        "generateUniqueNames": "boolean",
        "maxImageSizeBytes": "number"
      },
      "s3": {
        "bucketName": "string",
        "region": "string",
        "accessKeyId": "string",
        "secretAccessKey": "string"
      },
      "validation": {
        "requireAuthentication": "boolean",
        "maxFilesPerRequest": "number"
      },
      "storage": {
        "pathPrefix": "string",
        "publicRead": "boolean"
      }
    }
  },
  "use_cases": [
    "Image uploads with validation",
    "Document uploads (PDF, Word, Excel)",
    "CSV/Excel file imports",
    "Profile picture uploads",
    "Bulk file uploads",
    "File uploads to cloud storage (S3, Azure Blob, GCS)",
    "File virus scanning before storage",
    "Image resizing and thumbnail generation"
  ],
  "examples": [
    {
      "name": "File Upload Verticle",
      "description": "Upload files to local storage with validation",
      "operations": ["File size validation", "MIME type validation", "Local file storage", "Unique filename generation"]
    },
    {
      "name": "Image Upload S3 Verticle",
      "description": "Upload images to AWS S3 with validation",
      "operations": ["Image validation", "S3 upload", "Public URL generation", "Temporary file cleanup"]
    }
  ],
  "file_operations": [
    "Retrieve uploaded files from context.fileUploads()",
    "Validate file size and MIME type",
    "Move files from temp location to target storage",
    "Upload files to cloud storage (S3, Azure, GCS)",
    "Generate unique filenames with UUID",
    "Delete temporary files after processing"
  ],
  "validation_patterns": [
    "File size validation (maxFileSizeBytes)",
    "MIME type validation (allowedMimeTypes)",
    "File extension validation",
    "Maximum files per request limit",
    "Image-specific validation (dimensions, format)"
  ],
  "best_practices": [
    "Validate file size before processing",
    "Validate MIME types to allow only expected file types",
    "Generate unique filenames using UUIDs",
    "Use config().getData() for configuration",
    "Clean up temporary files after processing",
    "Set proper HTTP status codes (413 for too large, 415 for unsupported type)",
    "Handle file I/O errors gracefully",
    "Close external clients (S3, cloud storage) in stop()"
  ],
  "error_codes": [
    {
      "code": 400,
      "description": "No files uploaded"
    },
    {
      "code": 413,
      "description": "File too large (Payload Too Large)"
    },
    {
      "code": 415,
      "description": "Unsupported Media Type (MIME type not allowed)"
    },
    {
      "code": 500,
      "description": "File upload failed (server error)"
    }
  ],
  "platform_managed": [
    "Deployment and routing",
    "Configuration loading",
    "Endpoint registration",
    "Worker thread pool management",
    "Multipart form data parsing"
  ],
  "resource_cleanup": [
    "Delete temporary uploaded files",
    "Close S3/cloud storage clients",
    "Release file handles",
    "Clean up image processing resources"
  ]
}
