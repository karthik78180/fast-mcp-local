{
  "type": "platform-sync",
  "name": "Platform SyncHandler",
  "description": "Synchronous, blocking handler for SOAP services, JDBC databases, and legacy systems",
  "template_file": "templates/platform-sync-handler.md",
  "handler_interface": "SyncHandler",
  "thread_model": "worker_pool",
  "blocking_allowed": true,
  "gradle_dependencies": [
    "io.vertx:vertx-core:4.5.0",
    "io.vertx:vertx-web:4.5.0",
    "javax.xml.soap:javax.xml.soap-api:1.4.0",
    "com.sun.xml.messaging.saaj:saaj-impl:1.5.3",
    "mysql:mysql-connector-java:8.0.33",
    "org.postgresql:postgresql:42.6.0"
  ],
  "interface_methods": [
    "void start(Vertx vertx, JsonObject config)",
    "void handle(RoutingContext context)",
    "void stop()",
    "JsonObject getData()"
  ],
  "config_structure": {
    "lambda_json": {
      "artifactId": "string",
      "verticleClass": "string",
      "version": "string",
      "endpoint": "string",
      "handlerType": "SyncHandler"
    },
    "config_json": {
      "soap": {
        "endpoint": "string",
        "soapAction": "string",
        "namespace": "string",
        "timeout": "number",
        "username": "string",
        "password": "string"
      },
      "database": {
        "jdbcUrl": "string",
        "username": "string",
        "password": "string",
        "driverClass": "string",
        "queryTimeout": "number"
      },
      "retry": {
        "maxAttempts": "number",
        "delayMs": "number"
      }
    }
  },
  "use_cases": [
    "SOAP web service calls",
    "Legacy JDBC database queries",
    "File system operations (read/write files)",
    "Blocking HTTP clients",
    "Thread.sleep() or blocking computations",
    "Integration with legacy systems",
    "Synchronous message queue operations"
  ],
  "examples": [
    {
      "name": "SOAP Service Verticle",
      "description": "Call SOAP web services with blocking operations",
      "operations": ["SOAP message creation", "SOAP service calls", "XML parsing"]
    },
    {
      "name": "JDBC Query Verticle",
      "description": "Traditional JDBC database operations",
      "operations": ["Database connections", "SQL queries", "Result set processing"]
    }
  ],
  "best_practices": [
    "Use SyncHandler for blocking operations",
    "Always cleanup resources in try-finally blocks",
    "Handle exceptions properly",
    "Close database connections to prevent leaks",
    "Use config().getData() for configuration",
    "Set timeouts for blocking operations",
    "Return proper HTTP status codes",
    "Clean up file handles and connections"
  ],
  "resource_cleanup": [
    "Close JDBC connections, statements, and result sets",
    "Close SOAP connections",
    "Release file handles",
    "Clean up thread resources"
  ],
  "platform_managed": [
    "Deployment and routing",
    "Configuration loading",
    "Endpoint registration",
    "Worker thread pool management"
  ]
}
