{
  "type": "postgres",
  "name": "PostgreSQL Verticle",
  "description": "Database client verticle for PostgreSQL operations with reactive connection pooling",
  "template_file": "templates/postgres-verticle.md",
  "gradle_dependencies": [
    "io.vertx:vertx-core:4.5.0",
    "io.vertx:vertx-pg-client:4.5.0"
  ],
  "config_keys": [
    "postgres.host",
    "postgres.port",
    "postgres.database",
    "postgres.user",
    "postgres.password",
    "postgres.poolSize"
  ],
  "use_cases": [
    "CRUD operations on PostgreSQL database",
    "Connection pooling for high-performance applications",
    "Reactive database queries with non-blocking I/O",
    "Microservices with PostgreSQL backend"
  ]
}
